import { useState } from "react";

export default function RepoExplorer({ onFileSelect }) {

    const [repo] = useState([
        {
            folder: "contact-flows",
            files: [
                "cfAccountStatus.json",
                "cfCardActivation.json"
            ]
        },
        {
            folder: "lambdas",
            files: [
                "accountLookup.ts",
                "activation.ts"
            ]
        },
        {
            folder: "terraform",
            files: [
                "main.tf",
                "variables.tf"
            ]
        }
    ]);

    return (
        <div className="repo-panel">

            <div className="repo-title">
                Repo Explorer
            </div>

            {repo.map(section => (

                <div key={section.folder}>

                    <div className="folder">
                        📁 {section.folder}
                    </div>

                    {section.files.map(file => (

                        <div
                            key={file}
                            className="file"
                            onClick={() => onFileSelect(file)}
                        >
                            📄 {file}
                        </div>

                    ))}

                </div>

            ))}

        </div>
    );
}

