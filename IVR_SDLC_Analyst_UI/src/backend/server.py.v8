@asynccontextmanager
async def lifespan(app: FastAPI):
    if sys.platform == "win32":
        try:
            loop = asyncio.get_running_loop()
            print(
                f"[SYSTEM] Active operational loop: {type(loop).__name__}"
            )
        except RuntimeError:
            pass

    yield


app = FastAPI(lifespan=lifespan)

app.add_middleware(
    CORSMiddleware,
    allow_origins=[
        "*"
    ],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"]
)

